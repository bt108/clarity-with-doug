# Copy to .env for local dev. NEVER commit .env.
# Production values live in CI secrets / hosting env, NOT in git.

# PayPal — client ID used by CheckoutForm.astro ("sb" = PayPal sandbox fallback)
PUBLIC_PAYPAL_CLIENT_ID=sb

# Web3Forms — one key per form surface
PUBLIC_WEB3FORMS_CHECKOUT_KEY=dev-checkout-placeholder
PUBLIC_WEB3FORMS_CONTACT_KEY=dev-contact-placeholder

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Empty = GTM disabled.
PUBLIC_GTM_ID=
