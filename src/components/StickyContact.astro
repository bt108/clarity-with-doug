---
const WHATSAPP = "https://wa.me/17273089422";
---

<div class="fixed bottom-6 right-5 z-50 sm:bottom-8">
  <a
    href={WHATSAPP}
    target="_blank"
    rel="noreferrer"
    aria-label="Message Doug on WhatsApp"
    title="Message Doug on WhatsApp"
    class="group flex items-center gap-2 rounded-full bg-primary text-primary-foreground shadow-2xl ring-2 ring-primary-foreground transition-all hover:scale-105 hover:pr-5 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
  >
    <span class="grid h-14 w-14 shrink-0 place-items-center">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
      </svg>
    </span>
    <span class="hidden max-w-0 overflow-hidden whitespace-nowrap text-sm font-medium transition-all duration-300 group-hover:max-w-[10rem] sm:group-hover:inline">
      Chat with Doug
    </span>
  </a>
</div>
