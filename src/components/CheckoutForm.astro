---
import type { Offer } from "../lib/offers";

interface Props {
  offers: Offer[];
}

const { offers } = Astro.props;
// Secrets via env (see .env.example). Dev fallbacks keep `bun run build` green without real keys.
const paypalClientId =
  import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || "sb";
const web3formsKey =
  import.meta.env.PUBLIC_WEB3FORMS_CHECKOUT_KEY || "dev-checkout-placeholder";
---

<div
  id="checkout-root"
  data-offers={JSON.stringify(offers)}
  data-paypal-client-id={paypalClientId}
  data-web3forms-key={web3formsKey}
>
  <!-- Invalid product state -->
  <div id="checkout-invalid" hidden class="py-20 text-center">
    <h1 class="font-serif text-3xl text-ink sm:text-4xl">Product not found</h1>
    <p class="mt-4 type-body">
      The product you're looking for doesn't exist.
    </p>
    <a
      href="/services"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
    >
      View all services
    </a>
  </div>

  <!-- Checkout form -->
  <div id="checkout-form-wrapper" hidden>
    <a href="/services" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Back to services
    </a>

    <!-- Product summary -->
    <div class="mt-6 rounded-2xl border border-border bg-card p-6 shadow-sm">
      <div class="flex items-baseline justify-between gap-4">
        <h1 id="checkout-product-name" class="font-serif text-2xl text-ink sm:text-3xl"></h1>
        <span id="checkout-product-price" class="shrink-0 font-serif text-3xl text-ink"></span>
      </div>
      <p id="checkout-product-note" class="mt-1 text-sm text-muted-foreground"></p>
    </div>

    <!-- Form -->
    <form id="checkout-form" class="mt-8 grid gap-6" novalidate>
      <!-- Your details -->
      <fieldset class="grid gap-5">
        <legend class="font-serif text-xl text-ink">Your details</legend>
        <div class="grid gap-2">
          <label for="checkout-name" class="text-sm font-medium text-foreground">
            Full name <span aria-hidden="true" class="text-primary">*</span>
          </label>
          <input
            id="checkout-name"
            type="text"
            name="name"
            required
            autocomplete="name"
            placeholder="Your full name"
            class="rounded-lg border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>
        <div class="grid gap-2">
          <label for="checkout-email" class="text-sm font-medium text-foreground">
            Email <span aria-hidden="true" class="text-primary">*</span>
          </label>
          <input
            id="checkout-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="rounded-lg border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>
      </fieldset>

      <!-- Your birth details -->
      <fieldset class="grid gap-5">
        <legend class="font-serif text-xl text-ink">Your birth details</legend>
        <div class="grid items-start gap-5 sm:grid-cols-2">
          <div class="grid gap-2">
            <label for="checkout-birth-date" class="text-sm font-medium text-foreground">
              Birth date <span aria-hidden="true" class="text-primary">*</span>
            </label>
            <input
              id="checkout-birth-date"
              type="date"
              name="birthDate"
              required
              class="rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            />
          </div>
          <div class="grid gap-2">
            <label for="checkout-birth-time" class="text-sm font-medium text-foreground">
              Birth time
            </label>
            <input
              id="checkout-birth-time"
              type="time"
              name="birthTime"
              class="rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            />
            <p class="text-xs text-muted-foreground">Approximate is fine, exact is ideal.</p>
          </div>
        </div>
        <div class="grid gap-2">
          <label for="checkout-birth-location" class="text-sm font-medium text-foreground">
            Birth location <span aria-hidden="true" class="text-primary">*</span>
          </label>
          <input
            id="checkout-birth-location"
            type="text"
            name="birthLocation"
            required
            placeholder="City and country, e.g. London, UK"
            class="rounded-lg border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>
      </fieldset>

      <!-- Person 2 birth details (compatibility only) -->
      <fieldset id="person2-fields" hidden class="grid gap-5">
        <legend class="font-serif text-xl text-ink">Their birth details</legend>
        <div class="grid gap-2">
          <label for="checkout-p2-name" class="text-sm font-medium text-foreground">
            Their name <span aria-hidden="true" class="text-primary">*</span>
          </label>
          <input
            id="checkout-p2-name"
            type="text"
            name="person2Name"
            placeholder="Their full name"
            class="rounded-lg border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>
        <div class="grid items-start gap-5 sm:grid-cols-2">
          <div class="grid gap-2">
            <label for="checkout-p2-birth-date" class="text-sm font-medium text-foreground">
              Birth date <span aria-hidden="true" class="text-primary">*</span>
            </label>
            <input
              id="checkout-p2-birth-date"
              type="date"
              name="person2BirthDate"
              class="rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            />
          </div>
          <div class="grid gap-2">
            <label for="checkout-p2-birth-time" class="text-sm font-medium text-foreground">
              Birth time
            </label>
            <input
              id="checkout-p2-birth-time"
              type="time"
              name="person2BirthTime"
              class="rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            />
            <p class="text-xs text-muted-foreground">Approximate is fine, exact is ideal.</p>
          </div>
        </div>
        <div class="grid gap-2">
          <label for="checkout-p2-birth-location" class="text-sm font-medium text-foreground">
            Birth location <span aria-hidden="true" class="text-primary">*</span>
          </label>
          <input
            id="checkout-p2-birth-location"
            type="text"
            name="person2BirthLocation"
            placeholder="City and country, e.g. London, UK"
            class="rounded-lg border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
        </div>
      </fieldset>

      <!-- PayPal: shown only when form is valid -->
      <div id="paypal-button-container" class="mt-2"></div>
      <!-- Message shown while form is incomplete -->
      <p id="paypal-gate-msg" class="mt-2 text-sm font-medium text-primary">
        Please fill in all required fields above to continue to payment.
      </p>

      <!-- Trust signals -->
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border pt-4">
        <p class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <svg class="h-3.5 w-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Secure payment via PayPal
        </p>
        <p class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <svg class="h-3.5 w-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          Doug replies personally within 24 hours
        </p>
        <p class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <svg class="h-3.5 w-3.5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          1,200+ clients across six continents
        </p>
      </div>

      <!-- Error message -->
      <div id="checkout-error" hidden class="rounded-xl border border-destructive/20 bg-destructive/5 px-4 py-4 text-sm text-foreground">
        <p id="checkout-error-msg"></p>
        <a
          href="https://wa.me/17273089422"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          Contact Doug on WhatsApp
        </a>
      </div>
    </form>
  </div>

  <!-- Success state -->
  <div id="checkout-success" hidden class="py-20 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
      <svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <h1 class="mt-6 font-serif text-3xl text-ink sm:text-4xl">Payment received</h1>
    <p id="checkout-order-id" class="mt-3 text-sm text-muted-foreground"></p>
    <p class="mx-auto mt-4 max-w-md type-body">
      Doug will review your details and be in touch within 24 hours.
    </p>
    <a
      href="/services"
      class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline"
    >
      Back to services
    </a>
  </div>
</div>

<script>
  interface OfferData {
    slug: string;
    name: string;
    price: string;
    priceValue: string;
    priceNote: string;
    isCompatibility?: boolean;
  }

  const root = document.getElementById("checkout-root")!;
  const offers: OfferData[] = JSON.parse(root.dataset.offers!);
  const paypalClientId = root.dataset.paypalClientId!;
  const web3formsKey = root.dataset.web3formsKey!;

  const invalidEl = document.getElementById("checkout-invalid")!;
  const formWrapper = document.getElementById("checkout-form-wrapper")!;
  const successEl = document.getElementById("checkout-success")!;
  const errorEl = document.getElementById("checkout-error")!;
  const errorMsg = document.getElementById("checkout-error-msg")!;
  const form = document.getElementById("checkout-form") as HTMLFormElement;
  const paypalContainer = document.getElementById("paypal-button-container")!;
  const paypalGateMsg = document.getElementById("paypal-gate-msg")!;

  const ERROR_CLASS = "!border-destructive";
  const ERROR_MSG_CLASS = "field-error";

  // Look up the product from URL param
  const slug = new URLSearchParams(window.location.search).get("product");

  // Redirect ongoing-guidance to contact page
  if (slug === "ongoing-guidance") {
    window.location.href = "/contact";
  } else {
    const offer = slug ? offers.find((o) => o.slug === slug) : undefined;

    if (!offer) {
      invalidEl.hidden = false;
    } else {
      formWrapper.hidden = false;
      initCheckout(offer);
    }
  }

  function initCheckout(offer: OfferData) {
    // GA4 begin_checkout tracking
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: "begin_checkout",
      ecommerce: {
        value: parseFloat(offer.priceValue),
        currency: "USD",
        items: [{
          item_name: offer.name,
          price: parseFloat(offer.priceValue),
          quantity: 1,
        }],
      },
    });

    // Populate product summary
    document.getElementById("checkout-product-name")!.textContent = offer.name;
    document.getElementById("checkout-product-price")!.textContent = offer.price;
    document.getElementById("checkout-product-note")!.textContent = offer.priceNote;

    // Show person 2 fields for compatibility
    if (offer.isCompatibility) {
      const p2 = document.getElementById("person2-fields")!;
      p2.hidden = false;
      for (const input of p2.querySelectorAll<HTMLInputElement>("input[name='person2Name'], input[name='person2BirthDate'], input[name='person2BirthLocation']")) {
        input.required = true;
      }
    }

    // Live validation: toggle PayPal buttons and clear errors as user types
    form.addEventListener("input", (e) => {
      updatePayPalGate();
      const input = e.target;
      if (input instanceof HTMLInputElement) {
        // Clear error only if the field is now valid
        if (getFieldError(input) === "") clearFieldError(input);
      }
    });

    // Show inline error when user leaves a field that's invalid
    form.addEventListener("focusout", (e) => {
      const input = e.target;
      if (!(input instanceof HTMLInputElement)) return;
      const msg = getFieldError(input);
      if (msg) showFieldError(input, msg);
    });

    // Initial gate state — hide real PayPal buttons until form is valid
    paypalContainer.hidden = true;
    updatePayPalGate();

    // Load PayPal SDK
    loadPayPalSDK(paypalClientId)
      .then(() => renderPayPalButtons(offer))
      .catch(() => showError("Payment system unavailable. Please contact Doug directly."));
  }

  /** Show PayPal buttons only when form is complete */
  function updatePayPalGate() {
    const valid = isFormComplete();
    paypalContainer.hidden = !valid;
    paypalGateMsg.hidden = valid;
  }

  /** Quick check: are all required fields filled (without showing errors)? */
  function isFormComplete(): boolean {
    for (const input of form.querySelectorAll<HTMLInputElement>("input[required]")) {
      if (getFieldError(input) !== "") return false;
    }
    return true;
  }

  /** Returns error message for a single field, or "" if valid */
  function getFieldError(input: HTMLInputElement): string {
    const val = input.value.trim();
    if (input.required && !val) return getEmptyMessage(input);
    if (input.type === "email" && val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
      return "Please enter a valid email address.";
    }
    return "";
  }

  /** Full validation — marks fields with inline errors, returns true if valid */
  function validateForm(): boolean {
    let firstInvalid: HTMLInputElement | null = null;

    for (const input of form.querySelectorAll<HTMLInputElement>("input[required]")) {
      const msg = getFieldError(input);
      if (msg) {
        showFieldError(input, msg);
        if (!firstInvalid) firstInvalid = input;
      } else {
        clearFieldError(input);
      }
    }

    return !firstInvalid;
  }

  function getEmptyMessage(input: HTMLInputElement): string {
    const labels: Record<string, string> = {
      "checkout-name": "Please enter your name.",
      "checkout-email": "Please enter your email address.",
      "checkout-birth-date": "Please enter your date of birth.",
      "checkout-birth-location": "Please enter your birth location (city and country).",
      "checkout-p2-name": "Please enter their name.",
      "checkout-p2-birth-date": "Please enter their date of birth.",
      "checkout-p2-birth-location": "Please enter their birth location (city and country).",
    };
    return labels[input.id] || "This field is required.";
  }

  function showFieldError(input: HTMLInputElement, msg: string) {
    input.classList.add(ERROR_CLASS);
    // Add or update error message below input
    let errEl = input.parentElement?.querySelector("." + ERROR_MSG_CLASS) as HTMLParagraphElement | null;
    if (!errEl) {
      errEl = document.createElement("p");
      errEl.className = `${ERROR_MSG_CLASS} mt-1 text-xs font-medium text-destructive`;
      // Insert after input (or after the helper text if present)
      const sibling = input.nextElementSibling;
      if (sibling && sibling.tagName === "P" && !sibling.classList.contains(ERROR_MSG_CLASS)) {
        sibling.after(errEl);
      } else {
        input.after(errEl);
      }
    }
    errEl.textContent = msg;
  }

  function clearFieldError(input: HTMLInputElement) {
    input.classList.remove(ERROR_CLASS);
    input.parentElement?.querySelector("." + ERROR_MSG_CLASS)?.remove();
  }

  function loadPayPalSDK(clientId: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(clientId)}&currency=USD&intent=capture`;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error("Failed to load PayPal SDK"));
      document.head.appendChild(script);
    });
  }

  function renderPayPalButtons(offer: OfferData) {
    const paypal = (window as any).paypal;
    paypal.Buttons({
      style: {
        layout: "vertical",
        color: "gold",
        shape: "pill",
        label: "pay",
      },

      createOrder: (_data: any, actions: any) => {
        // Double-check validation (overlay should prevent this, but be safe)
        if (!validateForm()) {
          return Promise.reject(new Error("Form validation failed"));
        }

        return actions.order.create({
          purchase_units: [{
            description: offer.name,
            amount: {
              currency_code: "USD",
              value: offer.priceValue,
            },
          }],
        });
      },

      onApprove: async (_data: any, actions: any) => {
        try {
          const order = await actions.order.capture();
          const transactionId = order.purchase_units[0].payments.captures[0].id;

          // GA4 purchase tracking
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "purchase",
            ecommerce: {
              transaction_id: transactionId,
              value: parseFloat(offer.priceValue),
              currency: "USD",
              items: [{
                item_name: offer.name,
                price: parseFloat(offer.priceValue),
                quantity: 1,
              }],
            },
          });

          sendEmail(offer, transactionId).catch((err) => console.error("Email send failed:", err));
          showSuccess(transactionId);
        } catch (err) {
          showError("Payment could not be completed. Please try again.");
          console.error("PayPal capture error:", err);
        }
      },

      onError: (err: any) => {
        // Don't show error if it was just a validation rejection
        if (err?.message === "Form validation failed") return;
        showError("Something went wrong with the payment. Please try again.");
        console.error("PayPal error:", err);
      },
    }).render("#paypal-button-container");
  }

  function getFormData() {
    return {
      name: (document.getElementById("checkout-name") as HTMLInputElement).value.trim(),
      email: (document.getElementById("checkout-email") as HTMLInputElement).value.trim(),
      birthDate: (document.getElementById("checkout-birth-date") as HTMLInputElement).value,
      birthTime: (document.getElementById("checkout-birth-time") as HTMLInputElement).value || "",
      birthLocation: (document.getElementById("checkout-birth-location") as HTMLInputElement).value.trim(),
      person2Name: (document.getElementById("checkout-p2-name") as HTMLInputElement)?.value.trim() || "",
      person2BirthDate: (document.getElementById("checkout-p2-birth-date") as HTMLInputElement)?.value || "",
      person2BirthTime: (document.getElementById("checkout-p2-birth-time") as HTMLInputElement)?.value || "",
      person2BirthLocation: (document.getElementById("checkout-p2-birth-location") as HTMLInputElement)?.value.trim() || "",
    };
  }

  function formatDate(iso: string): string {
    const [y, m, d] = iso.split("-");
    const months = ["January","February","March","April","May","June",
      "July","August","September","October","November","December"];
    return `${parseInt(d)} ${months[parseInt(m) - 1]} ${y}`;
  }

  function formatTime(t: string): string {
    if (!t) return "Not provided";
    const [h, m] = t.split(":").map(Number);
    const suffix = h >= 12 ? "PM" : "AM";
    const hour12 = h % 12 || 12;
    return `${hour12}:${m.toString().padStart(2, "0")} ${suffix}`;
  }

  async function sendEmail(offer: OfferData, transactionId: string) {
    const data = getFormData();

    let message = `Product: ${offer.name} (${offer.price})\nTransaction ID: ${transactionId}\n\n`;
    message += `Name: ${data.name}\nEmail: ${data.email}\n\n`;
    message += `Birth Date: ${formatDate(data.birthDate)}\nBirth Time: ${formatTime(data.birthTime)}\nBirth Location: ${data.birthLocation}`;

    if (offer.isCompatibility && data.person2Name) {
      message += `\n\n--- Person 2 ---\n`;
      message += `Name: ${data.person2Name}\nBirth Date: ${formatDate(data.person2BirthDate)}\nBirth Time: ${formatTime(data.person2BirthTime)}\nBirth Location: ${data.person2BirthLocation}`;
    }

    await fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        access_key: web3formsKey,
        subject: `New order: ${offer.name} — ${data.name}`,
        from_name: data.name,
        email: data.email,
        message,
      }),
    });
  }

  function showSuccess(transactionId: string) {
    formWrapper.hidden = true;
    document.getElementById("checkout-order-id")!.textContent = `Order ID: ${transactionId}`;
    successEl.hidden = false;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function showError(msg: string) {
    errorMsg.textContent = msg;
    errorEl.hidden = false;
  }
</script>
