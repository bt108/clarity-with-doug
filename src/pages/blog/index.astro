---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Base
  title="Blog — Doug Greenberg"
  description="Insights on astrology, relationships, timing, and personal growth from Doug Greenberg."
>
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-10 lg:py-20">
    <div class="mb-12">
      <p class="type-eyebrow">Writing</p>
      <h1 class="mt-4 type-section-heading sm:text-5xl text-balance">
        Notes from the work.
      </h1>
      <p class="mt-5 max-w-xl type-body">
        Thoughts on timing, relationships, astrology, and what I'm noticing in the practice.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="rounded-2xl border border-border bg-card p-10 text-center">
        <p class="type-card-title">No posts yet.</p>
        <p class="mt-2 text-sm text-muted-foreground">Check back soon — Doug writes occasionally.</p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const dateStr = post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
          return (
            <article class="group relative flex flex-col rounded-2xl border border-border bg-card p-7 transition-all hover:-translate-y-1 hover:border-gold hover:shadow-xl has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-primary has-[a:focus-visible]:ring-offset-2">
              <div class="flex flex-wrap gap-2 mb-4">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full border border-gold/40 bg-gold/10 px-2.5 py-0.5 text-xs uppercase tracking-wider text-primary">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="type-card-title leading-snug">
                <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 focus-visible:outline-none">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground line-clamp-3">
                {post.data.description}
              </p>
              <p class="mt-5 text-xs text-muted-foreground">{dateStr}</p>
            </article>
          );
        })}
      </div>
    )}
  </section>
</Base>
