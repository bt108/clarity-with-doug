---
import Base from "../layouts/Base.astro";
import { SOLO_OFFERS, COMPATIBILITY, TIERS } from "../lib/offers";

const FAQS = [
  {
    q: "Does this actually work — or is astrology just symbolic?",
    a: "Both, and that's the point. The chart doesn't predict what will happen — it maps the patterns, timing, and forces that are already shaping your life. What I've found over 25 years is that when people see those patterns clearly, the decisions and feelings they've been stuck on often resolve themselves. The astrology gives us a precise framework. The insight comes from the conversation.",
  },
  {
    q: "What if I don't know what to ask?",
    a: "Most people don't, and that's fine. You don't need a formed question — bring the feeling. 'I feel stuck' or 'something isn't right but I can't name it' is exactly where we start. Part of my work is helping you find the right question, not just answering one.",
  },
  {
    q: "What's the difference between a reading and a clarity session?",
    a: "A reading answers your specific questions — Doug studies the chart, writes a report, and walks you through it on a call. A clarity session goes further: it combines the chart with coaching to help you actually move through what the chart reveals. Most people start with a reading and continue into sessions.",
  },
  {
    q: "How do I know which to start with?",
    a: "If you have one specific question, start with the One Question reading ($20) — it's the clearest entry point. If you want to explore more broadly, Three Questions gives Doug room to connect the full picture. If you're ready to go deeper into what's actually driving things, the First Session is the right place. If you're not sure, send a WhatsApp and Doug will tell you honestly.",
  },
  {
    q: "Do I need to know anything about astrology?",
    a: "Nothing at all. I don't use technical language in sessions — the chart is the map, but the conversation is in plain English about your life. You bring your situation; I bring the framework.",
  },
  {
    q: "What do I need to prepare?",
    a: "Your date, time, and place of birth — that's it. The birth time matters most, as it's what makes the reading specific to you rather than general. If you don't have it, we can still work with what you know. Sessions are conducted by call (WhatsApp or phone) or video (WhatsApp or Zoom) — whichever suits you.",
  },
  {
    q: "Will you judge my situation?",
    a: "No. I've worked with people across every kind of relationship, decision, and circumstance — including ones people have never told anyone else about. My only interest is in helping you understand your situation clearly. There's nothing you could bring to a session that would change that.",
  },
  {
    q: "What if I can't afford the full rate?",
    a: "Sliding scale rates are available for people in genuinely difficult financial circumstances. Send me a WhatsApp and we'll find something that works.",
  },
];

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: FAQS.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
};
---

<Base
  title="Astrology Readings & Clarity Sessions — Doug Greenberg"
  schema={[faqSchema]}
  description="Vedic astrology readings and life clarity coaching with Doug Greenberg. One question answered for $20, full sessions from $75. St. Petersburg, FL."
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 paper-texture opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-16 lg:px-10 lg:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-2">

        <!-- Left: headline -->
        <div>
          <p class="flex items-center gap-3 type-eyebrow">
            <span class="h-px w-10 bg-gold"></span>
            Astrology &amp; Clarity Work
          </p>
          <h1 class="mt-6 type-section-heading sm:text-5xl lg:text-6xl text-balance">
            Start with a question. Go as deep as you need.
          </h1>
          <p class="mt-6 type-body-lead max-w-md">
            Most people start with a reading. The chart reveals what's driving things — the coaching work helps you move through it.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="#readings"
              class="inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90"
            >
              Start with a Reading
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a
              href="#coaching"
              class="inline-flex items-center gap-2 rounded-full border border-gold/60 bg-gold/10 px-7 py-3 text-base font-medium text-primary transition-colors hover:bg-gold/20"
            >
              Explore Coaching
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Right: where to start card -->
        <div class="lg:pt-2">
          <div class="rounded-2xl border border-gold/30 bg-gold/5 p-8">
            <p class="type-eyebrow">Where to start</p>
            <ul class="mt-6 divide-y divide-border">
              <li class="flex items-start gap-5 pb-6">
                <span class="shrink-0 font-serif text-5xl leading-none text-gold/25">1</span>
                <div class="pt-1">
                  <p class="font-serif text-lg text-ink">Start with astrology</p>
                  <p class="mt-1.5 type-body text-pretty">One or three questions — Doug writes a detailed report, then walks you through it on a call.</p>
                </div>
              </li>
              <li class="flex items-start gap-5 pt-6">
                <span class="shrink-0 font-serif text-5xl leading-none text-gold/25">2</span>
                <div class="pt-1">
                  <p class="font-serif text-lg text-ink">Go deeper with coaching</p>
                  <p class="mt-1.5 type-body text-pretty">When you're ready to move through what the chart reveals — not just understand it.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Astrology Readings -->
  <section id="readings" class="bg-cream py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="max-w-2xl">
        <p class="type-eyebrow">Vedic Astrology</p>
        <h2 class="mt-4 type-section-heading sm:text-5xl">Your chart, read clearly.</h2>
        <p class="mt-5 type-body">
          Vedic and Western astrology for relationships, career, and what's ahead. 25 years of practice — readings that give you real answers, not vague generalities.
        </p>
        <p class="mt-3 type-body">
          Every reading begins with a written report. Doug studies your chart, writes a detailed response to your question, and then you discuss it together on a call. You keep the report.
        </p>
      </div>

      <!-- How it works -->
      <div class="mt-12 relative">
        <!-- connecting line (desktop) -->
        <div class="absolute top-9 left-[calc(12.5%+1rem)] right-[calc(12.5%+1rem)] hidden h-px bg-border sm:block" aria-hidden="true"></div>
        <ol class="relative grid gap-8 sm:grid-cols-4 sm:gap-4">
          {[
            {
              n: "1",
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>`,
              title: "Book",
              body: "Send your question and birth details. Doug confirms within 24 hours.",
            },
            {
              n: "2",
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
              title: "Receive your report",
              body: "Doug studies your chart and writes a detailed, personalised answer to your question.",
            },
            {
              n: "3",
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
              title: "Read it yourself",
              body: "Review the report at your own pace and note what you want to explore further.",
            },
            {
              n: "4",
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.58v-.66z"/></svg>`,
              title: "Call with Doug",
              body: "A focused call to discuss the report, ask your questions, and go as deep as you need.",
            },
          ].map((step) => (
            <li class="relative flex flex-col items-center text-center">
              <div class="relative z-10 flex h-[4.5rem] w-[4.5rem] items-center justify-center rounded-full border border-gold/40 bg-background text-gold shadow-sm">
                <Fragment set:html={step.icon} />
              </div>
              <p class="mt-4 font-serif text-base text-ink">{step.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 max-w-3xl mx-auto">
        {SOLO_OFFERS.map((offer) => (
          <div
            class={`relative flex flex-col rounded-2xl border p-7 ${
              offer.highlight
                ? "border-gold bg-background shadow-[0_24px_64px_-12px_oklch(0.44_0.14_38/0.22)]"
                : "border-border bg-card"
            }`}
          >
            {offer.highlight && (
              <span
                aria-label="Start here — free"
                class="absolute top-3 right-3 grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"
              >
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </span>
            )}
            <p class="type-card-title">{offer.name}</p>
            <div class="mt-2">
              <p class="font-serif text-4xl text-ink">{offer.price}</p>
              <p class="mt-0.5 text-xs text-muted-foreground">{offer.priceNote}</p>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{offer.copy}</p>
            <ul class="mt-5 flex-1 space-y-2 border-t border-border pt-4 text-sm text-foreground/90">
              {offer.features.map((f) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={`/checkout?product=${offer.slug}`}
              class={`mt-6 inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-colors ${
                offer.highlight
                  ? "bg-primary text-primary-foreground hover:bg-primary/90"
                  : "border border-primary/40 text-primary hover:bg-primary/5"
              }`}
            >
              {offer.cta}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        ))}
      </div>

      <!-- Compatibility -->
      <div class="mt-6 mx-auto max-w-3xl">
        <div class="flex flex-col rounded-2xl border border-gold bg-background p-7 shadow-[0_24px_64px_-12px_oklch(0.44_0.14_38/0.18)] sm:flex-row sm:items-start sm:gap-8">
          <div class="sm:flex-1">
            <p class="type-card-title">Compatibility Reading</p>
            <div class="mt-2">
              <p class="font-serif text-4xl text-ink">{COMPATIBILITY.price}</p>
              <p class="mt-0.5 text-xs text-muted-foreground">{COMPATIBILITY.priceNote}</p>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              For marital, family, or business relationships. Understand what makes each other tick — the strengths, the challenges, and how long certain dynamics will last.
            </p>
          </div>
          <div class="mt-5 sm:mt-0 sm:flex-1">
            <ul class="space-y-2 text-sm text-foreground/90">
              {COMPATIBILITY.features.map((f) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={`/checkout?product=${COMPATIBILITY.slug}`}
              class="mt-5 inline-flex items-center justify-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
            >
              {COMPATIBILITY.cta}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bridge -->
  <section class="relative py-10 lg:py-14">
    <div class="absolute inset-0 paper-texture opacity-40" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
      <div class="mx-auto max-w-4xl border-l-4 border-gold pl-8 py-4">
        <blockquote class="font-serif text-2xl lg:text-3xl italic leading-snug text-ink">
          "If your reading reveals a pattern you want to move through — not just understand — that's where the clarity work begins."
        </blockquote>
        <p class="mt-4 type-body">
          A reading tells you what's in the chart. A session changes what you do with it. Many clients move from a reading into ongoing sessions when they're ready to go deeper.
        </p>
      </div>
    </div>
  </section>

  <!-- Clarity Coaching -->
  <section id="coaching" class="bg-cream py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="type-eyebrow">Clarity Sessions</p>
        <h2 class="mt-4 type-section-heading sm:text-5xl">From insight to movement.</h2>
        <p class="mt-5 type-body">
          Sessions combine astrology with life coaching — working with the deeper pattern, not just the surface question.
        </p>
      </div>

      <div class="mt-10 grid gap-6 min-[850px]:grid-cols-3 min-[850px]:grid-rows-[auto_auto_auto_1fr_auto]">
        {TIERS.map((t) => (
          <div
            class={`relative flex flex-col rounded-2xl border p-6 min-[850px]:row-span-5 min-[850px]:grid min-[850px]:grid-rows-subgrid min-[850px]:p-8 ${
              t.highlight
                ? "border-gold bg-background shadow-[0_24px_64px_-12px_oklch(0.44_0.14_38/0.22)]"
                : "border-border bg-card"
            }`}
          >
            {t.highlight && (
              <span
                aria-label="Most chosen"
                class="absolute top-3 right-3 grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-foreground"
              >
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </span>
            )}
            <div>
              <p class="type-card-title">{t.name}</p>
            </div>
            <p class="mt-1 text-sm text-muted-foreground min-[850px]:mt-0">{t.for}</p>
            <div class="mt-3 min-[850px]:-mt-1 flex items-start gap-2">
              <div>
                <p class="font-serif text-4xl text-ink">{t.price}</p>
                {t.priceNote && <p class="mt-0.5 text-xs text-muted-foreground">{t.priceNote}</p>}
              </div>
              {t.scarce && (
                <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                  Limited availability
                </span>
              )}
            </div>
            <ul class="mt-4 flex-1 space-y-2 border-t border-border pt-4 text-sm text-foreground/90 min-[850px]:mt-0 min-[850px]:flex-none">
              {t.features.map((f) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={t.cta === "Enquire" ? `/contact?prefill=${encodeURIComponent(t.prefill)}` : `/checkout?product=${t.slug}`}
              class={`mt-5 inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-colors min-[850px]:mt-0 ${
                t.highlight
                  ? "bg-primary text-primary-foreground hover:bg-primary/90"
                  : "border border-primary/40 bg-transparent text-primary hover:bg-primary/5"
              }`}
            >
              {t.cta}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        ))}
      </div>

      <figure class="relative overflow-hidden mx-auto mt-12 max-w-2xl rounded-2xl border border-border bg-background p-8 shadow-[0_4px_24px_-8px_oklch(0.44_0.14_38/0.10)]">
        <span aria-hidden="true" class="pointer-events-none absolute right-5 top-2 select-none font-serif text-[7rem] leading-none text-gold/[0.12]">"</span>
        <blockquote class="relative font-serif text-lg italic leading-relaxed text-ink">
          "I'd been carrying the same question about my relationship for nearly two years — going in circles, unable to see it clearly. After one session with Doug I finally understood what was actually driving my confusion. That shift in perspective was everything."
        </blockquote>
        <figcaption class="mt-7 flex items-center gap-4">
          <span class="h-px w-10 shrink-0 bg-gold" aria-hidden="true"></span>
          <div>
            <p class="font-serif text-base text-primary">Natalie</p>
            <p class="mt-0.5 text-xs uppercase tracking-[0.22em] text-muted-foreground">Odessa, TX</p>
          </div>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-16 lg:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-6 lg:gap-14 lg:grid-cols-12 lg:px-10">
      <div class="lg:col-span-4">
        <p class="type-eyebrow mb-4">Common questions</p>
        <h2 class="type-section-heading sm:text-5xl">
          Everything you might be wondering.
        </h2>
        <p class="mt-6 text-muted-foreground">
          Still unsure?{" "}
          <a
            href="https://wa.me/17273089422"
            target="_blank"
            rel="noreferrer"
            class="font-medium text-primary underline-offset-2 hover:underline"
          >
            Send Doug a WhatsApp
          </a>
          {" "}— he answers every message personally.
        </p>
      </div>
      <div class="lg:col-span-8">
        <div class="w-full divide-y divide-border border-t border-border">
          {FAQS.map((f) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-serif text-lg text-ink [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg
                  class="ml-4 h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="pb-4 pt-0 type-body">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="relative overflow-hidden bg-primary py-14 lg:py-16">
    <div class="absolute inset-0 paper-texture opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center lg:px-10">
      <h2 class="font-serif text-3xl leading-tight text-primary-foreground sm:text-4xl">
        Start with one question.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-primary-foreground/85">
        For $20, Doug reads your chart, writes a detailed answer, and walks you through it on a call. The clearest way to see what your chart has to say.
      </p>
      <div class="mt-8">
        <a
          href={`/checkout?product=${SOLO_OFFERS[0].slug}`}
          class="inline-flex items-center gap-2 rounded-full bg-primary-foreground px-7 py-3 text-base font-medium text-primary transition-colors hover:bg-primary-foreground/90"
        >
          Get My Answer — $20
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

</Base>

<script>
  // FAQ close animation
  document.querySelectorAll<HTMLDetailsElement>("#faq details").forEach((el) => {
    el.querySelector("summary")?.addEventListener("click", (e) => {
      if (!el.open) return;
      e.preventDefault();
      el.classList.add("closing");
      el.addEventListener("animationend", () => {
        el.classList.remove("closing");
        el.removeAttribute("open");
      }, { once: true });
    });
  });
</script>
