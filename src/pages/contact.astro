---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Base
  title="Get in Touch — Doug Greenberg"
  description="Reach out to Doug Greenberg. He reads every message personally and replies within 24 hours."
>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 paper-texture opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-14 lg:px-10 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-14 lg:items-start">

        <!-- Left col: headline -->
        <div class="lg:col-span-7">
          <p class="flex items-center gap-3 type-eyebrow lg:justify-start justify-center">
            <span class="h-px w-10 bg-gold"></span>
            Get in Touch
            <span class="h-px w-10 bg-gold lg:hidden"></span>
          </p>
          <h1 class="mt-6 font-serif text-4xl leading-tight text-ink sm:text-5xl text-center lg:text-left text-balance">
            Just tell me what's going on.
          </h1>
          <p class="mt-5 type-body-lead text-center lg:text-left">
            Whatever's happening — in your relationship, your life, your head — just say it as it is. Doug reads every message personally and replies within 24 hours.
          </p>
        </div>

        <!-- Right col: warm note card -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-gold/30 bg-gold/5 p-7">
            <h2 class="font-serif text-xl text-ink">Good to know</h2>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
                <span class="type-body text-pretty">You don't need a formed question. Bring the situation as it is.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
                <span class="type-body text-pretty">There's nothing you could share that would surprise Doug.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
                <span class="type-body text-pretty">Sessions are unhurried — Doug works at your pace, not against a clock.</span>
              </li>
            </ul>
            <div class="mt-5 border-t border-gold/20 pt-4 space-y-1.5">
              <p class="flex items-center gap-2 text-xs text-muted-foreground">
                <svg class="h-3.5 w-3.5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                No commitment required
              </p>
              <p class="flex items-center gap-2 text-xs text-muted-foreground">
                <svg class="h-3.5 w-3.5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                Doug replies personally — not an assistant
              </p>
              <p class="flex items-center gap-2 text-xs text-muted-foreground">
                <svg class="h-3.5 w-3.5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                Readings start at just $20
              </p>
            </div>
            <a
              href="https://wa.me/17273089422"
              target="_blank"
              rel="noreferrer"
              class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
              Open a direct WhatsApp chat &rarr;
            </a>
          </div>
        </div>

      </div>

      <!-- Scroll invite -->
      <div class="mt-12 flex justify-center lg:mt-14">
        <a
          href="#contact"
          class="group flex flex-col items-center gap-2 text-muted-foreground transition-colors hover:text-primary"
          aria-label="Scroll to contact form"
        >
          <span class="text-[0.65rem] uppercase tracking-[0.28em]">Leave a message</span>
          <span class="h-px w-8 bg-gold/40 transition-colors group-hover:bg-gold"></span>
          <svg
            class="h-4 w-4 text-gold"
            style="animation: float-down 2s ease-in-out infinite;"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <ContactForm />

</Base>
